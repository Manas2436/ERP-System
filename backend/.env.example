# ─────────────────────────────────────────────────────────────────────────────
# College ERP – Authentication Module  |  Backend Environment Template
# Copy this file to .env (never commit .env) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database (MySQL 8.0) ──────────────────────────────────────────────────────
# DB_HOST / DB_PORT: leave as localhost/3306 for local development
DB_HOST=localhost
DB_PORT=3306
# DB_NAME: the canonical database name — created by Stage 3 migration if absent
DB_NAME=college_erp
# DB_USER / DB_PASSWORD: your MySQL user credentials (never commit real values)
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
# DB_CONNECTION_LIMIT: max simultaneous connections in the pool (10 is a safe default)
DB_CONNECTION_LIMIT=10


# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Secret must be at least 32 characters. Production startup fails if absent or too short.
JWT_SECRET=replace_with_a_long_random_secret_minimum_32_chars
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ── Password Hashing ──────────────────────────────────────────────────────────
# bcrypt cost factor (rounds). Min 10, production default 12. Higher = slower = safer.
BCRYPT_ROUNDS=12

# ── Password Reset ────────────────────────────────────────────────────────────
PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

# ── CAPTCHA (e.g., Google reCAPTCHA v2 / hCaptcha) ───────────────────────────
CAPTCHA_SECRET_KEY=replace_with_your_captcha_secret
CAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed client origins (e.g. Vite :5173, CRA :3000)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email (for password-reset emails — Stage 6) ──────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=replace_with_smtp_password
EMAIL_FROM=College ERP <no-reply@example.com>

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
