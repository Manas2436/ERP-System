{
  "name": "college-erp-auth-backend",
  "version": "1.0.0",
  "description": "Express.js REST API backend for the College ERP Authentication Module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup:db": "node scripts/setupDb.js",
    "migrate": "node scripts/migrate.js",
    "verify:schema": "node scripts/verifySchema.js",
    "test:stage5": "node scripts/testStage5.js",
    "test:stage6": "node --test scripts/testStage6.js",
    "test:stage7": "node --test scripts/testStage7.js",
    "test:stage8": "node --test scripts/testStage8.js",
    "test:stage9": "node --test scripts/testStage9.js",
    "test:stage12": "node --test scripts/testStage12.js",
    "test:stage13": "node --test scripts/testStage13.js",
    "test:stage14": "node --test scripts/testStage14.js",
    "test:stage15": "jest --runInBand",
    "test:unit": "jest tests/unit --runInBand",
    "test:integration": "jest tests/integration --runInBand",
    "test": "jest --runInBand"
  },
  "exports": {
    ".": "./server.js",
    "./middleware": "./src/middleware/index.js"
  },
  "keywords": [
    "college-erp",
    "authentication",
    "express",
    "nodejs"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  }
}
