# ─────────────────────────────────────────────────────────────────────────────
# College ERP – Authentication Module  |  Frontend Environment Template
# Copy this file to .env (Vite/CRA reads REACT_APP_ or VITE_ prefixed vars)
# ─────────────────────────────────────────────────────────────────────────────

# Backend API base URL
REACT_APP_API_BASE_URL=http://localhost:5000/api/v1

# CAPTCHA site key (public key — safe to expose in frontend)
REACT_APP_CAPTCHA_SITE_KEY=replace_with_your_captcha_site_key
